# ==============================================================================
# Aperture Automotive Assembly Tool Monitoring - Environment Configuration
# ==============================================================================

# Gemini AI API Key (Get key from https://aistudio.google.com/)
# When populated, live machine stops & root-cause analyses are generated by Gemini Flash.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (Production fast model)
GEMINI_MODEL=gemini-2.5-flash

# Database URL (Defaults to local SQLite if not configured)
DATABASE_URL=sqlite:///./tool_monitor.db

# JWT Secret Key
SECRET_KEY=your_jwt_secret_key_here

# Vendor / Cloud Run API Base URL (Configurable via Environment)
VENDOR_API_BASE_URL=https://ais-dev-xzxljhsxlkzopqgvxgcwvc-509615976446.asia-southeast1.run.app
VENDOR_BLE_GATEWAY_URL=https://ais-dev-xzxljhsxlkzopqgvxgcwvc-509615976446.asia-southeast1.run.app/api/simulation/hardware
VENDOR_BLE_GATEWAY_API_KEY=your_vendor_gateway_api_key_here
VENDOR_BLE_GATEWAY_AUTO_POLL=true
SEED_DEMO_DATA=false
